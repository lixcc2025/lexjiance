{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "src/env.d.ts",
    "tests/**/*.ts"
  ]
}